# Copiez ce fichier en .env et remplissez-le, OU (recommandé) déclarez ces mêmes
# clés dans Supabase : Project Settings → Edge Functions → Secrets (elles ne doivent
# JAMAIS être commises dans Git ni exposées au front).

# --- Fournies automatiquement par Supabase (ne pas toucher) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- CinetPay (Mobile Money MTN/Orange + carte bancaire, zone CEMAC/UEMOA) ---
# Créez un compte marchand sur https://cinetpay.com puis récupérez ces valeurs
# dans votre tableau de bord CinetPay (Intégration → Clés API).
CINETPAY_APIKEY=
CINETPAY_SITE_ID=

# --- PayPal (international) ---
# Créez une app sur https://developer.paypal.com (commencez en mode "Sandbox").
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- PawaPay (Mobile Money, Afrique de l'Est/Ouest/Centrale) ---
PAWAPAY_API_TOKEN=
PAWAPAY_ENV=sandbox

# --- iKeePay (Mobile Money, mode H2H), ajouté le 2026-10-12 EN PLUS de PawaPay — n'affecte pas
# PawaPay, qui continue de fonctionner indépendamment, avec ou sans ces clés renseignées.
# Tant que IKEEPAY_SECRET_KEY n'est pas renseignée, create-order refuse explicitement tout
# paiement iKeePay (pas de simulation sandbox implicite, comme pour PawaPay) : PawaPay et les
# autres prestataires continuent de fonctionner normalement.
IKEEPAY_API_BASE_URL=https://api.ikeepay.com
IKEEPAY_SECRET_KEY=
# IKEEPAY_WEBHOOK_SECRET : ⚠️ NON UTILISÉE pour l'instant — le support iKeePay a confirmé que les
# webhooks sont signés en HMAC-SHA256 (en-tête X-ikeepay-signature), mais pas encore (1) quel
# secret l'alimente, (2) ce qui est exactement signé (corps brut ou champs concaténés), (3)
# l'encodage (hex/base64). Tant que ces 3 points ne sont pas confirmés, ikeepay-webhook refuse
# TOUJOURS les notifications (fail-safe) — voir _shared/ikeepay.ts.
IKEEPAY_WEBHOOK_SECRET=
# IKEEPAY_REQUIRE_SIGNATURE=false désactive temporairement la vérification de signature —
# UNIQUEMENT pour tester le flux en sandbox, jamais en production (même principe que
# PAWAPAY_REQUIRE_SIGNATURE ci-dessus).
IKEEPAY_REQUIRE_SIGNATURE=true

# --- URLs publiques ---
PUBLIC_APP_URL=https://www.ifriqi.com
PUBLIC_FUNCTIONS_URL=https://VOTRE-PROJET.functions.supabase.co

# Tant que CINETPAY_APIKEY/PAYPAL_CLIENT_ID ne sont pas renseignées, les fonctions
# create-order et payment-webhook tournent en mode "sandbox" explicite : elles créent
# bien de vraies lignes en base (commandes, paiements, commissions), mais aucun
# débit réel n'a jamais lieu. C'est voulu : vous pouvez tester tout le flux (y compris
# le calcul des commissions à 2 niveaux) avant d'avoir vos identifiants prestataires.
